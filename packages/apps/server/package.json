{
    "name": "@chatgpt-telegram-workers/server",
    "version": "1.10.7",
    "type": "module",
    "main": "./dist/node.js",
    "scripts": {
        "build": "pnpm vite build -c vite.node.config.ts && pnpm vite build -c vite.vercel.config.ts && pnpm tsx scripts/docker-package.ts",
        "start": "pnpm tsx src/node.ts",
        "start:dist": "node dist/node.js",
        "clean": "rm -rf dist && rm -rf node_modules && rm -rf tsconfig.tsbuildinfo"
    },
    "dependencies": {
        "@chatgpt-telegram-workers/core": "workspace:*",
        "ioredis": "^5.11.1",
        "jsonc-parser": "^3.3.1",
        "sqlite3": "^5.1.7",
        "telegram-bot-api-types": "^10.2.0",
        "telegramify-markdown": "^1.3.0",
        "undici": "^7.1.0"
    },
    "devDependencies": {
        "@chatgpt-telegram-workers/test-mocks": "workspace:*",
        "@vercel/node": "^5.4.1",
        "typescript": "^5.9.3"
    }
}
