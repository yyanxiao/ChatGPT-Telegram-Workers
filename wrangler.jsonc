{
    // Cloudflare Workers Builds deploys this file as-is — you don't need to edit it:
    //   - the DATABASE KV namespace id is injected at deploy time from the DEPLOY_KV_NAMESPACE_ID build variable
    //   - bot credentials (TELEGRAM_TOKEN, ADMIN_ID, ...) are managed in the dashboard
    //     under Settings -> Variables and Secrets
    //
    // For CLI deploys (`pnpm run deploy`) fill in the KV namespace id below
    // and add a "vars" block with your bot credentials.
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "chatgpt-telegram-workers",
    // Bundles directly from the TypeScript source; workspace dependencies resolve to
    // their built output (pnpm run build:workers). The root dist/ folder is only for
    // copy-paste deployments in the Cloudflare dashboard.
    "main": "./packages/apps/workers/src/index.ts",
    // nodejs_compat is enabled by default at this date, no compatibility flags needed.
    "compatibility_date": "2026-08-04",

    // Never delete dashboard variables on deploy (secrets are always preserved).
    "keep_vars": true,

    // `local` is the wrangler dev placeholder for "not configured" and passes config
    // validation. Cloudflare Workers Builds replaces it via the DEPLOY_KV_NAMESPACE_ID
    // build variable; CLI deploys replace it with a real id here.
    "kv_namespaces": [{ "binding": "DATABASE", "id": "local" }],
}
